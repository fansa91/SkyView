<Project Sdk="Microsoft.NET.Sdk">

  <!--
    非 UI 层：模型 / 数据源 / 服务 / ViewModel / 存储。
    刻意不引用 WinUI 与 Windows App SDK —— 这样单元测试与组件测试
    可以在没有图形会话、没有 WinAppSDK 运行时的环境里正常运行。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SkyView</RootNamespace>
    <AssemblyName>SkyView.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <!-- DPAPI，用于加密本地保存的 API Key -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="5.0.0" />
  </ItemGroup>

</Project>
