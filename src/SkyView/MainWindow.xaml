<Window
    x:Class="SkyView.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SkyView"
    xmlns:views="using:SkyView.Views"
    Title="SkyView">

    <Grid>
        <NavigationView x:Name="RootNavigation"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="True"
                        SelectionChanged="RootNavigation_SelectionChanged"
                        PaneDisplayMode="Left"
                        OpenPaneLength="200"
                        CompactPaneLength="48">
            <NavigationView.MenuItems>
                <!--
                    用 FontIcon 而不是 Icon="Symbol 名称"：
                    Symbol 枚举在 WinUI 3 里缺项（例如 Place 不存在），
                    写成字符串会在 InitializeComponent 阶段抛 XamlParseException，
                    表现为应用启动即崩溃（0xC000027B）。
                -->
                <NavigationViewItem x:Name="HomeNavItem" Content="天气" Tag="Home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9CA;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="CityNavItem" Content="城市" Tag="City">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE707;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="DataSourcesNavItem" Content="数据源" Tag="DataSources">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="SettingsNavItem" Content="设置" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>

</Window>
