<Page
    x:Class="SkyView.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SkyView"
    xmlns:converters="using:SkyView.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="所有修改实时保存、即时生效，无需手动点保存。数据源（API Key / 优先级 / 功能分配）请到左侧「数据源」页。"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- 偏好设置 -->
        <Border Grid.Row="1"
                VerticalAlignment="Top"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                AutomationProperties.AutomationId="PreferencesCard">
            <StackPanel Spacing="10">
                <TextBlock Text="显示与刷新" Style="{StaticResource SubtitleTextBlockStyle}" />

                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="温度单位"
                               VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                  OnContent="华氏度 °F"
                                  OffContent="摄氏度 °C"
                                  IsOn="{x:Bind ViewModel.UseFahrenheit, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="UnitToggle" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="自动刷新（分钟）"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <NumberBox Value="{x:Bind ViewModel.AutoRefreshMinutes, Mode=TwoWay}"
                                   Minimum="0"
                                   Maximum="240"
                                   SmallChange="5"
                                   SpinButtonPlacementMode="Compact"
                                   Width="140"
                                   AutomationProperties.AutomationId="AutoRefreshBox" />
                        <TextBlock Text="0 表示关闭自动刷新"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="逐小时条数"
                               VerticalAlignment="Center" />
                    <NumberBox Grid.Row="2" Grid.Column="1"
                               Value="{x:Bind ViewModel.HourlyCount, Mode=TwoWay}"
                               Minimum="4"
                               Maximum="24"
                               SmallChange="2"
                               SpinButtonPlacementMode="Compact"
                               Width="140"
                               HorizontalAlignment="Left"
                               AutomationProperties.AutomationId="HourlyCountBox" />

                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Text="生活指数"
                               VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Row="3" Grid.Column="1"
                                  OnContent="显示"
                                  OffContent="隐藏"
                                  IsOn="{x:Bind ViewModel.ShowLifeIndex, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="LifeIndexToggle" />
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       AutomationProperties.AutomationId="StatusText"
                       Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource EmptyToVisibility}}" />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="打开日志目录"
                        Click="OpenLogFolder_Click"
                        AutomationProperties.AutomationId="OpenLogFolderButton"
                        AutomationProperties.Name="打开日志目录" />

                <!-- 版本号由构建时从 git tag 注入（见 SkyView.csproj 的 ResolveVersionFromGitTag） -->
                <TextBlock Text="{x:Bind VersionText}"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           AutomationProperties.AutomationId="VersionText"
                           AutomationProperties.Name="应用版本" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
