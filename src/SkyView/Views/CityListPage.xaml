<Page
    x:Class="SkyView.Views.CityListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SkyView"
    xmlns:models="using:SkyView.Models"
    xmlns:viewmodels="using:SkyView.ViewModels"
    xmlns:controls="using:SkyView.Controls"
    xmlns:converters="using:SkyView.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DefaultBindMode="OneWay"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />

        <Style x:Key="CityCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="城市" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="每张卡片显示该城市当前天气。点击卡片可在主页查看详情；列表保存在本机。"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="NewCityBox"
                     Grid.Column="0"
                     PlaceholderText="输入城市名，例如：杭州"
                     AutomationProperties.AutomationId="NewCityBox" />
            <Button x:Name="AddCityButton"
                    Grid.Column="1"
                    Content="添加"
                    Click="AddCity_Click"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AutomationId="AddCityButton" />
        </Grid>

        <!--
            自适应卡片网格：GridView 默认用 ItemsWrapGrid，按可用宽度自动换行，
            每张卡固定宽 220，窗口变宽时一行容纳更多卡 —— 即「瀑布式卡片」。
        -->
        <GridView Grid.Row="2"
                  ItemsSource="{x:Bind Cards, Mode=OneWay}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="Cards_ItemClick"
                  AutomationProperties.AutomationId="CityWeatherGrid">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:CityWeatherCard">
                    <Border Style="{StaticResource CityCardStyle}"
                            Width="220"
                            Margin="8"
                            AutomationProperties.Name="{x:Bind City}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{x:Bind City}"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />

                            <!-- 加载中 -->
                            <ProgressRing IsActive="{x:Bind IsLoading}"
                                          Width="30" Height="30"
                                          HorizontalAlignment="Center"
                                          Visibility="{x:Bind IsLoading, Converter={StaticResource BoolToVisibility}}" />

                            <!-- 出错 -->
                            <TextBlock Text="{x:Bind Error}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Visibility="{x:Bind Error, Converter={StaticResource EmptyToVisibility}}" />

                            <!-- 有数据时展示 -->
                            <Grid ColumnSpacing="10"
                                  VerticalAlignment="Center"
                                  Visibility="{x:Bind HasData, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <controls:WeatherIcon Grid.Column="0"
                                                      Width="52" Height="52"
                                                      IsAnimated="False"
                                                      Kind="{x:Bind Current.IconKind}" />

                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind DisplayTemperature}"
                                           Style="{StaticResource DisplayTextBlockStyle}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Text="{x:Bind Current.Condition}"
                                       Visibility="{x:Bind HasData, Converter={StaticResource BoolToVisibility}}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />

                            <TextBlock Text="{x:Bind DetailLine}"
                                       Visibility="{x:Bind HasData, Converter={StaticResource BoolToVisibility}}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
