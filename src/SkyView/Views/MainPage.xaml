<Page
    x:Class="SkyView.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SkyView"
    xmlns:models="using:SkyView.Models"
    xmlns:controls="using:SkyView.Controls"
    xmlns:converters="using:SkyView.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:TemperatureConverter x:Key="TempConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
        <converters:NumberFormatConverter x:Key="NumberFormat" />
        <converters:DateTimeFormatConverter x:Key="DateTimeFormat" />
        <converters:AqiToBrushConverter x:Key="AqiBrush" />
        <converters:UvToBrushConverter x:Key="UvBrush" />
        <converters:AlertLevelToBrushConverter x:Key="AlertBrush" />

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Page.Resources>

    <!--
        天气主题背景：整页铺一层随天气变化的渐变。
        刻意拆成"底色 + 半透明渐变层"两层，而不是直接把渐变画在根 Grid 上 ——
        这样浅色/深色主题的底色仍然由 ApplicationPageBackgroundThemeBrush 决定，
        渐变只负责染色，不会让深色主题下整页变亮。
        不参与命中测试，避免挡住滚动和按钮。
    -->
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid x:Name="WeatherBackdrop"
              IsHitTestVisible="False"
              Opacity="0"
              AutomationProperties.AutomationId="WeatherBackdrop" />

        <Grid Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部工具栏 -->
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="CityInput"
                         Grid.Column="0"
                         Header="城市"
                         PlaceholderText="例如：北京"
                         Width="240"
                         AutomationProperties.AutomationId="CityInput"
                         AutomationProperties.Name="城市输入框"
                         Text="{x:Bind ViewModel.City, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!-- 刷新按钮的可用性由 RefreshCommand.CanExecute 控制（加载中自动禁用） -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Bottom">
                    <Button x:Name="LocateButton"
                            Content="定位"
                            MinWidth="88"
                            Click="Locate_Click"
                            ToolTipService.ToolTip="使用 Windows 定位服务找到当前城市"
                            AutomationProperties.AutomationId="LocateButton"
                            AutomationProperties.Name="定位当前城市" />

                    <Button x:Name="RefreshButton"
                            Content="刷新天气"
                            MinWidth="120"
                            AutomationProperties.AutomationId="RefreshButton"
                            AutomationProperties.Name="刷新天气"
                            Command="{x:Bind ViewModel.RefreshCommand}" />
                </StackPanel>
            </Grid>

            <ProgressBar Grid.Row="1"
                         x:Name="LoadingProgress"
                         IsIndeterminate="True"
                         AutomationProperties.AutomationId="LoadingProgress"
                         Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">

                    <!-- 缓存提示：断网/首次启动时明确告诉用户数据不是实时的 -->
                    <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            CornerRadius="8"
                            Padding="12,8"
                            AutomationProperties.AutomationId="CacheHintPanel"
                            Visibility="{x:Bind ViewModel.IsFromCache, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock x:Name="CacheHintText"
                                   Text="{x:Bind ViewModel.CacheHint, Mode=OneWay}"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   AutomationProperties.AutomationId="CacheHintText"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- 错误提示 -->
                    <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                            CornerRadius="8"
                            Padding="12"
                            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource EmptyToVisibility}}">
                        <TextBlock x:Name="ErrorText"
                                   Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="ErrorText" />
                    </Border>

                    <!-- 空状态引导（无数据、无错误时） -->
                    <TextBlock x:Name="EmptyHintText"
                               Text="还没有天气数据。填好城市后点「刷新天气」，或先到「设置」页配置数据源 API Key。"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.AutomationId="EmptyHintText"
                               Visibility="{x:Bind ViewModel.IsEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <!-- 当前天气（仅在成功拿到数据后显示，避免把默认值 0°C 当真实天气） -->
                    <Border x:Name="CurrentWeatherCard"
                            AutomationProperties.AutomationId="CurrentWeatherCard"
                            Visibility="{x:Bind ViewModel.HasCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource CardStyle}"
                            Padding="24">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind ViewModel.Current.City, Mode=OneWay}"
                                           Style="{StaticResource TitleTextBlockStyle}"
                                           VerticalAlignment="Center" />

                                <!-- 数据徽标组：空气质量 + UV 指数（数据源不提供的自动隐藏） -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- 空气质量徽标 -->
                                    <Border CornerRadius="6"
                                            Padding="8,4"
                                            AutomationProperties.AutomationId="AirQualityBadge"
                                            Background="{x:Bind ViewModel.Current.Aqi, Mode=OneWay, Converter={StaticResource AqiBrush}, ConverterParameter='Background'}"
                                            Visibility="{x:Bind ViewModel.Current.HasAirQuality, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock x:Name="AirQualityText"
                                                   Text="{x:Bind ViewModel.AirQualityText, Mode=OneWay}"
                                                   FontSize="13"
                                                   Foreground="{x:Bind ViewModel.Current.Aqi, Mode=OneWay, Converter={StaticResource AqiBrush}}" />
                                    </Border>

                                    <!-- UV 指数徽标（tier 1 新增，仅 Open-Meteo 等源提供） -->
                                    <Border CornerRadius="6"
                                            Padding="8,4"
                                            AutomationProperties.AutomationId="UvBadge"
                                            Background="{x:Bind ViewModel.UvLevel, Mode=OneWay, Converter={StaticResource UvBrush}, ConverterParameter='Background'}"
                                            Visibility="{x:Bind ViewModel.HasUvIndex, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock x:Name="UvIndexText"
                                                   Text="{x:Bind ViewModel.UvIndexText, Mode=OneWay}"
                                                   FontSize="13"
                                                   Foreground="{x:Bind ViewModel.UvLevel, Mode=OneWay, Converter={StaticResource UvBrush}}" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- 温度 + 天气图标 + 天气现象 -->
                            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Bottom">
                                <controls:WeatherIcon x:Name="CurrentIcon"
                                                      Width="76" Height="76"
                                                      VerticalAlignment="Center"
                                                      IsAnimated="True"
                                                      Kind="{x:Bind ViewModel.Current.IconKind, Mode=OneWay}"
                                                      AutomationProperties.AutomationId="WeatherIconCurrent" />

                                <!-- 绑 TemperatureText 而不是 Current.Temperature+转换器：
                                     单位切换只通知 TemperatureText，绑原始值的话这个大字不会变 -->
                                <TextBlock Text="{x:Bind ViewModel.TemperatureText, Mode=OneWay}"
                                           Style="{StaticResource DisplayTextBlockStyle}"
                                           VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="TemperatureText" />

                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.Current.Condition, Mode=OneWay}"
                                               Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.FeelsLikeText, Mode=OneWay}"
                                               AutomationProperties.AutomationId="FeelsLikeText"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 指标行：湿度 / 气压 / 风 / PM2.5 -->
                            <Grid ColumnSpacing="28" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="湿度" Style="{StaticResource MetricLabelStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <TextBlock Text="{x:Bind ViewModel.Current.Humidity, Mode=OneWay, Converter={StaticResource NumberFormat}, ConverterParameter='0'}" />
                                        <TextBlock Text="%" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="气压" Style="{StaticResource MetricLabelStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <TextBlock Text="{x:Bind ViewModel.Current.Pressure, Mode=OneWay, Converter={StaticResource NumberFormat}, ConverterParameter='0'}" />
                                        <TextBlock Text="hPa" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <!-- 气压趋势：对逐小时气压序列本地计算（▲/▼/→），数据源不给 hourly 气压时不显示 -->
                                        <TextBlock Text="{x:Bind ViewModel.PressureTrendText, Mode=OneWay}"
                                                   AutomationProperties.AutomationId="PressureTrendText"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{x:Bind ViewModel.HasPressureTrend, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="2"
                                            Visibility="{x:Bind ViewModel.Current.HasWind, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="风力" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.WindText, Mode=OneWay}"
                                               AutomationProperties.AutomationId="WindText" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Spacing="2"
                                            Visibility="{x:Bind ViewModel.Current.HasAirQuality, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="PM2.5" Style="{StaticResource MetricLabelStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <TextBlock Text="{x:Bind ViewModel.Current.Pm25, Mode=OneWay, Converter={StaticResource NumberFormat}, ConverterParameter='0'}" />
                                        <TextBlock Text="μg/m³" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- 详细指标行（tier 1 新增）：降水 / 云量 / 露点 / 阵风。
                                 数据源不提供的项自动隐藏，整行无可显示项时整行隐藏 -->
                            <Grid ColumnSpacing="28" RowSpacing="8"
                                  AutomationProperties.AutomationId="DetailMetricsGrid"
                                  Visibility="{x:Bind ViewModel.HasDetailMetrics, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2"
                                            Visibility="{x:Bind ViewModel.HasPrecipitationMetric, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="降水量" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.PrecipitationText, Mode=OneWay}"
                                               AutomationProperties.AutomationId="PrecipitationText" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="2"
                                            Visibility="{x:Bind ViewModel.HasCloudCoverMetric, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="云量" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.CloudCoverText, Mode=OneWay}"
                                               AutomationProperties.AutomationId="CloudCoverText" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="2"
                                            Visibility="{x:Bind ViewModel.HasDewPointMetric, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="露点" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.DewPointText, Mode=OneWay}"
                                               AutomationProperties.AutomationId="DewPointText" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Spacing="2"
                                            Visibility="{x:Bind ViewModel.HasWindGustsMetric, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="阵风" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.WindGustsText, Mode=OneWay}"
                                               AutomationProperties.AutomationId="WindGustsText" />
                                </StackPanel>
                            </Grid>

                            <!-- 短临降雨（tier 2 新增，Open-Meteo minutely_15 专属）：
                                 未来 2 小时分钟级预判。数据源不提供分钟级数据时整行隐藏 -->
                            <TextBlock Text="{x:Bind ViewModel.MinutelyRainText, Mode=OneWay}"
                                       AutomationProperties.AutomationId="MinutelyRainText"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Visibility="{x:Bind ViewModel.HasMinutelyRain, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                            <!-- 花粉（tier 3 新增，Open-Meteo Air Quality API，主要覆盖欧洲）：
                                 国内城市该接口五个花粉变量全返回 null，整行隐藏 -->
                            <TextBlock Text="{x:Bind ViewModel.PollenText, Mode=OneWay}"
                                       AutomationProperties.AutomationId="PollenText"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Visibility="{x:Bind ViewModel.HasPollen, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                            <!-- 日出日落 -->
                            <TextBlock Text="{x:Bind ViewModel.SunTimesText, Mode=OneWay}"
                                       AutomationProperties.AutomationId="SunTimesText"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Visibility="{x:Bind ViewModel.Current.HasSunTimes, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                            <!-- 观测时间 / 数据来源 -->
                            <TextBlock AutomationProperties.AutomationId="SourceText"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}">
                                <Run Text="观测时间：" />
                                <Run Text="{x:Bind ViewModel.Current.ObservedAt, Mode=OneWay, Converter={StaticResource DateTimeFormat}}" />
                                <Run Text="　来源：" />
                                <Run Text="{x:Bind ViewModel.Current.Source, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 恶劣天气预警（tier 3 新增）：本地从预报数据按阈值推导，
                         无免 Key 官方预警源时兜底；无触发时整卡隐藏 -->
                    <Border x:Name="AlertsCard"
                            Style="{StaticResource CardStyle}"
                            AutomationProperties.AutomationId="AlertsCard"
                            Visibility="{x:Bind ViewModel.HasAlerts, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="天气预警"
                                       AutomationProperties.AutomationId="AlertsTitle"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />

                            <ItemsControl x:Name="AlertsList"
                                          AutomationProperties.AutomationId="AlertsList"
                                          ItemsSource="{x:Bind ViewModel.Alerts, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:WeatherAlert">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,3">
                                            <Border CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                                    Background="{x:Bind Level, Converter={StaticResource AlertBrush}, ConverterParameter='Background'}">
                                                <TextBlock Text="{x:Bind LevelText}"
                                                           AutomationProperties.AutomationId="AlertLevel"
                                                           Foreground="{x:Bind Level, Converter={StaticResource AlertBrush}}"
                                                           FontSize="12" />
                                            </Border>
                                            <TextBlock Text="{x:Bind Kind}" VerticalAlignment="Center"
                                                       AutomationProperties.AutomationId="AlertKind" />
                                            <TextBlock Text="{x:Bind DateText}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind Reason}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 逐小时预报 -->
                    <Border x:Name="HourlyCard"
                            Style="{StaticResource CardStyle}"
                            AutomationProperties.AutomationId="HourlyCard"
                            Visibility="{x:Bind ViewModel.HasHourly, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="逐小时"
                                       AutomationProperties.AutomationId="HourlyTitle"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.HourlySourceText, Mode=OneWay}"
                                       AutomationProperties.AutomationId="HourlySourceText"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Visibility="{x:Bind ViewModel.HourlySourceText, Mode=OneWay, Converter={StaticResource EmptyToVisibility}}" />

                            <ScrollViewer x:Name="HourlyScroller"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollMode="Enabled"
                                          VerticalScrollMode="Disabled"
                                          SizeChanged="HourlyScroller_SizeChanged">
                                <ItemsControl x:Name="HourlyList"
                                              AutomationProperties.AutomationId="HourlyList"
                                              ItemsSource="{x:Bind ViewModel.Hourly, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:WeatherHourly">
                                            <StackPanel Spacing="4" Padding="4,8">
                                                <TextBlock Text="{x:Bind TimeText}"
                                                           HorizontalAlignment="Center"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <!-- 用图标替代原来的条件文字：74px 宽的格子里，图标比两三个汉字更容易扫读 -->
                                                <controls:WeatherIcon Width="30" Height="30"
                                                                      HorizontalAlignment="Center"
                                                                      IsAnimated="False"
                                                                      Kind="{x:Bind IconKind}"
                                                                      ToolTipService.ToolTip="{x:Bind Condition}"
                                                                      AutomationProperties.AutomationId="WeatherIconHourly" />
                                                <TextBlock Text="{x:Bind Temperature, Converter={StaticResource TempConverter}}"
                                                           HorizontalAlignment="Center"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind PrecipitationProbability}"
                                                           HorizontalAlignment="Center"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                           Visibility="{x:Bind HasPrecipitation, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- 温度趋势图（代码后置绘制） -->
                    <Border x:Name="TrendCard"
                            Style="{StaticResource CardStyle}"
                            AutomationProperties.AutomationId="TrendCard"
                            Visibility="{x:Bind ViewModel.HasForecast, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="温度趋势"
                                       AutomationProperties.AutomationId="TrendTitle"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ForecastSourceText, Mode=OneWay}"
                                       AutomationProperties.AutomationId="ForecastSourceText"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Visibility="{x:Bind ViewModel.ForecastSourceText, Mode=OneWay, Converter={StaticResource EmptyToVisibility}}" />
                            <Viewbox Stretch="Uniform" MaxHeight="180" HorizontalAlignment="Stretch">
                                <Canvas x:Name="TrendCanvas"
                                        Width="640"
                                        Height="170"
                                        AutomationProperties.AutomationId="TrendCanvas" />
                            </Viewbox>
                            <TextBlock Text="{x:Bind ViewModel.TrendRangeText, Mode=OneWay}"
                                       AutomationProperties.AutomationId="TrendRangeText"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- 未来几天预报 -->
                    <Border x:Name="ForecastCard"
                            Visibility="{x:Bind ViewModel.HasForecast, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            RenderTransformOrigin="0.5,0.5"
                            Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.ForecastTitleText, Mode=OneWay}"
                                       AutomationProperties.AutomationId="ForecastTitle"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />

                            <ItemsControl x:Name="ForecastList"
                                          AutomationProperties.AutomationId="ForecastList"
                                          ItemsSource="{x:Bind ViewModel.Forecast, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:WeatherForecast">
                                        <Grid ColumnSpacing="12" Padding="0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{x:Bind Date, Converter={StaticResource DateTimeFormat}, ConverterParameter='MM-dd'}" />
                                                <TextBlock Text="{x:Bind Sunrise}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Visibility="{x:Bind Sunrise, Converter={StaticResource EmptyToVisibility}}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <controls:WeatherIcon Width="26" Height="26"
                                                                      IsAnimated="False"
                                                                      Kind="{x:Bind IconKind}"
                                                                      AutomationProperties.AutomationId="WeatherIconForecast" />
                                                <TextBlock Text="{x:Bind Condition}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind TempHigh, Converter={StaticResource TempConverter}}"
                                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                <TextBlock Text="/" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind TempLow, Converter={StaticResource TempConverter}}"
                                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 生活指数 -->
                    <Border x:Name="LifeIndexCard"
                            Style="{StaticResource CardStyle}"
                            AutomationProperties.AutomationId="LifeIndexCard"
                            Visibility="{x:Bind ViewModel.HasLifeIndex, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="生活指数"
                                       AutomationProperties.AutomationId="LifeIndexTitle"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />

                            <ItemsControl x:Name="LifeIndexList"
                                          AutomationProperties.AutomationId="LifeIndexList"
                                          ItemsSource="{x:Bind ViewModel.LifeIndex, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:WeatherLifeIndex">
                                        <StackPanel Padding="0,6" Spacing="2">
                                            <TextBlock Text="{x:Bind Summary}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind Text}"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Visibility="{x:Bind Text, Converter={StaticResource EmptyToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}">
                        <Run Text="最后刷新：" />
                        <Run Text="{x:Bind ViewModel.LastUpdated, Mode=OneWay, Converter={StaticResource DateTimeFormat}, ConverterParameter='MM-dd HH:mm:ss'}" />
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
