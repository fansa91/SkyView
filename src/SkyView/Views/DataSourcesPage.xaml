<Page
    x:Class="SkyView.Views.DataSourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SkyView"
    xmlns:models="using:SkyView.Models"
    xmlns:converters="using:SkyView.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="天气数据源" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="为每个数据源填写 API Key，并按优先级决定请求顺序。所有修改实时保存、即时生效，无需手动点保存。Key 使用 Windows DPAPI 加密后保存在本机，不会明文落盘。"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Providers, Mode=OneWay}"
                  SelectionMode="None"
                  AutomationProperties.AutomationId="ProviderList">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,4" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ProviderConfigItem">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,4">
                        <StackPanel Spacing="10">
                            <CheckBox Content="{x:Bind DisplayName, Mode=OneWay}"
                                      IsChecked="{x:Bind Enabled, Mode=TwoWay}" />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="API Key:"
                                           VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <!--
                                        PasswordBox.Password 不是依赖属性，用 x:Bind 双向绑定不会回写；
                                        这里改用 PasswordChanged 事件把输入同步到 ViewModel。
                                    -->
                                    <PasswordBox x:Name="ApiKeyBox"
                                                 PasswordChanged="ApiKeyBox_PasswordChanged"
                                                 PlaceholderText="留空则保持不变"
                                                 AutomationProperties.AutomationId="ApiKeyBox"
                                                 AutomationProperties.Name="API Key 输入框" />
                                    <TextBlock Text="{x:Bind ApiKeyHint, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="API Host:"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{x:Bind ApiHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="和风天气需填控制台分配的专属 Host" />
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="优先级:"
                                           VerticalAlignment="Center" />
                                <NumberBox Grid.Column="1"
                                           Value="{x:Bind Priority, Mode=TwoWay}"
                                           Minimum="0"
                                           Maximum="99"
                                           SmallChange="1"
                                           SpinButtonPlacementMode="Compact"
                                           Width="140"
                                           AutomationProperties.AutomationId="PriorityBox" />
                            </Grid>

                            <!-- 测试连接：用界面上当前输入（含刚键入、尚未落盘的 Key）直接调一次接口 -->
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="测试连接"
                                        Click="TestConnection_Click"
                                        IsEnabled="{x:Bind CanTest, Mode=OneWay}"
                                        AutomationProperties.AutomationId="TestConnectionButton"
                                        AutomationProperties.Name="测试连接" />
                                <TextBlock Text="{x:Bind TestMessage, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           MaxWidth="480"
                                           AutomationProperties.AutomationId="TestResultText"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind TestMessage, Mode=OneWay, Converter={StaticResource EmptyToVisibility}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 功能数据源分配：每个功能可以单独选源（参考 Breezy Weather 的 per-feature source 模型） -->
        <!-- 注意：AutomationId 必须挂有 AutomationPeer 的控件（Border 没有 peer，挂了 UIA 树也看不到） -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <StackPanel Spacing="10">
                <TextBlock Text="功能数据源分配" Style="{StaticResource SubtitleTextBlockStyle}"
                           AutomationProperties.AutomationId="FeatureSourcesCard" />
                <TextBlock Text="每个功能可以单独指定用哪个数据源。选「自动」则按上面的优先级依次尝试；指定的源失败时，同样会自动回退到优先级链上的下一个。"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />

                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="当前天气"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{x:Bind ViewModel.FeatureSourceOptions, Mode=OneWay}"
                              SelectedValue="{x:Bind ViewModel.CurrentSource, Mode=TwoWay}"
                              SelectedValuePath="Name"
                              DisplayMemberPath="DisplayName"
                              Width="240"
                              HorizontalAlignment="Left"
                              AutomationProperties.AutomationId="FeatureSource_Current" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="天气预报"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              ItemsSource="{x:Bind ViewModel.FeatureSourceOptions, Mode=OneWay}"
                              SelectedValue="{x:Bind ViewModel.ForecastSource, Mode=TwoWay}"
                              SelectedValuePath="Name"
                              DisplayMemberPath="DisplayName"
                              Width="240"
                              HorizontalAlignment="Left"
                              AutomationProperties.AutomationId="FeatureSource_Forecast" />

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="逐小时预报"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Row="2" Grid.Column="1"
                              ItemsSource="{x:Bind ViewModel.FeatureSourceOptions, Mode=OneWay}"
                              SelectedValue="{x:Bind ViewModel.HourlySource, Mode=TwoWay}"
                              SelectedValuePath="Name"
                              DisplayMemberPath="DisplayName"
                              Width="240"
                              HorizontalAlignment="Left"
                              AutomationProperties.AutomationId="FeatureSource_Hourly" />

                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Text="生活指数"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Row="3" Grid.Column="1"
                              ItemsSource="{x:Bind ViewModel.FeatureSourceOptions, Mode=OneWay}"
                              SelectedValue="{x:Bind ViewModel.LifeIndexSource, Mode=TwoWay}"
                              SelectedValuePath="Name"
                              DisplayMemberPath="DisplayName"
                              Width="240"
                              HorizontalAlignment="Left"
                              AutomationProperties.AutomationId="FeatureSource_LifeIndex" />
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="测试用城市:"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox Text="{x:Bind ViewModel.TestCity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Width="140"
                         AutomationProperties.AutomationId="TestCityBox" />
            </StackPanel>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       AutomationProperties.AutomationId="StatusText"
                       Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource EmptyToVisibility}}" />
        </StackPanel>
    </Grid>
</Page>
